{
  "name": "webtanan-jalali-date-engine",
  "version": "0.11.0",
  "description": "موتور تاریخ شمسی حرفه‌ای برای JavaScript، TypeScript، React، Vue، Electron، Laravel و نرم‌افزارهای سازمانی",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": "./dist/browser/webtanan-jalali.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": "./dist/browser/webtanan-jalali.js",
    "./browser.min": "./dist/browser/webtanan-jalali.min.js",
    "./css": "./dist/browser/webtanan-jalali.css"
  },
  "files": ["dist", "README.md", "docs"],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "build:browser": "node scripts/build-browser.mjs",
    "build": "npm run clean && npm run build:types && npm run build:browser",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:ci": "npm run typecheck && npm test && npm run build"
  },
  "keywords": ["jalali", "persian-calendar", "datepicker", "iran", "rtl", "react", "vue", "electron", "laravel", "holidays", "official-holidays", "holiday-dataset", "persistence", "web-component", "rest", "database", "validation", "accessibility", "keyboard-navigation", "date-range", "multiple-dates", "disabled-dates", "themes", "dark-theme", "industrial-ui", "leap-year", "browser-bundle"],
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "esbuild": "^0.25.9",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "license": "MIT"
}
