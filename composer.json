{
  "name": "webtanan/jalali-date-engine",
  "description": "موتور حرفه‌ای تاریخ شمسی برای Laravel، PHP و فریم‌ورک‌های مدرن وب",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Webtanan\\JalaliDateEngine\\": "php/src/"
    }
  },
  "require": {
    "php": ">=8.1"
  },
  "suggest": {
    "illuminate/support": "برای یکپارچه‌سازی خودکار با Laravel",
    "illuminate/contracts": "برای استفاده از JalaliDateRule در Validation لاراول"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Webtanan\\JalaliDateEngine\\Laravel\\WebtananJalaliServiceProvider"
      ],
      "aliases": {
        "JalaliDate": "Webtanan\\JalaliDateEngine\\Laravel\\JalaliDateFacade"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
